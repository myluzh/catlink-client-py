# CATLINK 配置文件
# 将此文件复制为 .env 并填写你的配置

# ==================== 账号配置 ====================
# 手机号（不带国家代码）
CATLINK_PHONE=your_phone_number

# 密码
CATLINK_PASSWORD=your_password_here

# 国家代码，中国是 86
CATLINK_PHONE_IAC=86

# API 区域: global/china/usa/singapore
CATLINK_REGION=china

# 语言: zh_CN/en_US
CATLINK_LANGUAGE=zh_CN

# 设备通过 sortedListV2 接口自动发现，无需手工配置喂食器设备 ID。

# ==================== 设备控制开关 ====================
# 默认 0：所有真实设备控制方法在本地阻断，仅允许只读查询。
# 设为 1 等价于对当前进程开启写授权；也可在单个方法上传 allow_write=True。
CATLINK_ALLOW_DEVICE_CONTROL=0
